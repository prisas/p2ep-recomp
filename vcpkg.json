{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "p2ep",
    "version-string": "0.1.0",
    "dependencies": [
        {
            "name": "sdl3",
            "features": ["vulkan"]
        },
        "vulkan-headers",
        "volk",
        "vulkan-memory-allocator",
        {
            "name": "glslang",
            "features": ["tools"]
        },
        "stb",
        "xxhash",
        {
            "name": "ffmpeg",
            "default-features": false,
            "features": ["avcodec", "avfilter", "swscale", "swresample"]
        }
    ]
}
